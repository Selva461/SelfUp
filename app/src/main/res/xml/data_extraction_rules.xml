<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and up. The Groq key stays on the phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ai.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ai.xml" />
    </device-transfer>
</data-extraction-rules>
